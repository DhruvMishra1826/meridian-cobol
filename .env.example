# tools/meridian.py and tools/server.py use this journal directory unless --data-dir is set.
MERIDIAN_DATA_DIR=./data/meridian
# tools/server.py uses this bearer token; non-loopback binds and Docker require it.
# Generate rather than reuse a sample:
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MERIDIAN_API_TOKEN=
# docker-compose.yml uses this host loopback port; the container still listens on 8080.
MERIDIAN_HTTP_PORT=8080
# tools/client.py selects the compiled engine; tools/coverage.py overrides it for tests.
# Empty uses ./build/meridian. Otherwise set an absolute path to the executable.
MERIDIAN_ENGINE=
