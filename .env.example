# The native CLI and server use this directory when --data-dir is omitted.
MERIDIAN_DATA_DIR=./data/meridian
# Required for a non-loopback bind or Docker. Generate rather than reuse a sample:
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MERIDIAN_API_TOKEN=
# Optional engine override for instrumented or separately installed binaries:
# MERIDIAN_ENGINE=/absolute/path/to/meridian
